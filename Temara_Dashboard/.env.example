/**
 * Dashboard data proxy — keeps n8n auth secrets off the static client.
 * Set real values in Vercel Project Settings → Environment Variables.
 * Do NOT commit a .env file with production secrets.
 */

# Auth secret for /api/n8n-proxy → sent as x-agency-auth to n8n
N8N_AUTH_KEY=your-agency-auth-secret

# GET webhook that returns dashboard KPI JSON (used by /api/n8n-proxy)
# Must be your active ngrok URL — free tier requires ngrok-skip-browser-warning (handled by proxy)
N8N_WEBHOOK_URL=https://your-ngrok-host.ngrok-free.dev/webhook/dashboard-data

# Auth secret for /api/waitlist (can match N8N_AUTH_KEY)
N8N_AGENCY_AUTH_KEY=your-agency-auth-secret

# POST webhook for waitlist patient intake (used by /api/waitlist)
N8N_WAITLIST_WEBHOOK=https://your-ngrok-host.ngrok-free.dev/webhook-test/dashboard-waitlist-add

# Team notes webhooks (used by /api/team-notes)
N8N_WEBHOOK_GET_NOTES=https://your-ngrok-host.ngrok-free.dev/webhook/get-notes
N8N_WEBHOOK_POST_NOTE=https://your-ngrok-host.ngrok-free.dev/webhook/post-note

# Patient portal lead capture (used by /api/lead-capture)
N8N_WEBHOOK_LEAD_CAPTURE=https://your-ngrok-host.ngrok-free.dev/webhook/lead-capture

# ── Username/password auth (/api/auth) ─────────────────────────────────────
# Generate hashes from Temara_Dashboard folder:
#   node -e "const c=require('./api/_lib/auth-crypto');console.log(c.hashPassword('your-password'))"
JWT_SECRET=replace-with-long-random-secret-min-32-chars

DOCTOR_USERNAME=docteur
DOCTOR_PASSWORD_HASH=scrypt$paste-generated-hash-here

ASSISTANT_USERNAME=assistante
ASSISTANT_PASSWORD_HASH=scrypt$paste-generated-hash-here

# Optional Upstash Redis (dashboard-data / waitlist GET cache). If unset, APIs work uncached.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Baserow REST (used by /api/roster). Do not commit the real token.
BASEROW_API_TOKEN=your_baserow_database_token

# Rollback: unused by /api/roster after Baserow cutover
N8N_WEBHOOK_ROSTER=https://your-n8n-host/webhook/assistant-data
