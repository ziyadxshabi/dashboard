# DentaFlow OS — environment template (Temara Dashboard)
# Copy values into Vercel Project Settings → Environment Variables.
# Do NOT commit a real .env file with secrets.

# Clinic Authentication & Session Security
# Generate password hashes from Temara_Dashboard:
#   node -e "const c=require('./api/_lib/auth-crypto');console.log(c.hashPassword('your-password'))"
JWT_SECRET=
DOCTOR_USERNAME=
DOCTOR_PASSWORD_HASH=
ASSISTANT_USERNAME=
ASSISTANT_PASSWORD_HASH=

# Upstash Redis (Rate Limiting & Telemetry)
# Optional for cache; required for login rate limiting to persist across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Baserow Database
# BASEROW_TABLE_ID = Bookings (1017856). BASEROW_WAITLIST_TABLE_ID = Liste d'attente (1039940).
BASEROW_API_URL=https://api.baserow.io
BASEROW_API_TOKEN=
BASEROW_TABLE_ID=1017856
BASEROW_WAITLIST_TABLE_ID=1039940
BASEROW_LEADS_TABLE_ID=

# Upstream n8n Webhook Endpoints
# Full webhook URLs only. Frontend never calls these hosts.
# N8N_WEBHOOK_DASHBOARD_ASSISTANT maps to N8N_WEBHOOK_ASSISTANT_PROXY in /api/n8n.
# N8N_WEBHOOK_WAITLIST maps to N8N_WAITLIST_WEBHOOK (rollback; waitlist now uses Baserow).
# N8N_WEBHOOK_TEAM_NOTES: set both N8N_WEBHOOK_GET_NOTES and N8N_WEBHOOK_POST_NOTE in Vercel.
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_DASHBOARD=
N8N_WEBHOOK_DASHBOARD_ASSISTANT=
N8N_WEBHOOK_ROSTER=
N8N_WEBHOOK_UPDATE_STATUS=
N8N_WEBHOOK_WAITLIST=
N8N_WEBHOOK_FILL_GAP=
N8N_WEBHOOK_TEAM_NOTES=
N8N_WEBHOOK_BULK_SMS=
N8N_WEBHOOK_DELAY_ALERT=
N8N_WEBHOOK_LEAD_CAPTURE=

# Upstream Agency Authentication
# Sent as x-agency-auth. DASHBOARD_AUTH_KEY is preferred for /api/dashboard-data.
N8N_AUTH_KEY=
N8N_AGENCY_AUTH_KEY=
DASHBOARD_AUTH_KEY=

# Application & Deployment Settings
# VERCEL_FRONTEND_URL = allowed CORS origin. VERCEL_GIT_COMMIT_SHA is set by Vercel.
VERCEL_FRONTEND_URL=
VERCEL_GIT_COMMIT_SHA=
