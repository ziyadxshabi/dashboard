/**
 * Dashboard data proxy — keeps n8n auth secrets off the static client.
 * Set real values in Vercel Project Settings → Environment Variables.
 * Do NOT commit a .env file with production secrets.
 */

# Auth secret for /api/n8n-proxy → sent as x-agency-auth to n8n
N8N_AUTH_KEY=your-agency-auth-secret

# GET webhook that returns dashboard KPI JSON (used by /api/n8n-proxy)
# Must be your active ngrok URL — free tier requires ngrok-skip-browser-warning (handled by proxy)
N8N_WEBHOOK_URL=https://your-ngrok-host.ngrok-free.dev/webhook/dashboard-data

# Auth secret for /api/waitlist (can match N8N_AUTH_KEY)
N8N_AGENCY_AUTH_KEY=your-agency-auth-secret

# POST webhook for waitlist patient intake (used by /api/waitlist)
N8N_WAITLIST_WEBHOOK=https://your-ngrok-host.ngrok-free.dev/webhook-test/dashboard-waitlist-add
