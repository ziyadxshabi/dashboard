    {
      "parameters": {
        "jsCode": "// ── GATE: Roster API key (zero-trust, timing-safe) ─────────────────────────\nconst crypto = require('crypto');\n\nfunction timingSafeEqualStrings(a, b) {\n  const sa = String(a ?? '');\n  const sb = String(b ?? '');\n  const ba = Buffer.from(sa, 'utf8');\n  const bb = Buffer.from(sb, 'utf8');\n  if (ba.length !== bb.length) return false;\n  return crypto.timingSafeEqual(ba, bb);\n}\n\nfunction readAgencyAuthHeader(h) {\n  const bag = h ?? {};\n  for (const [key, value] of Object.entries(bag)) {\n    if (key && key.toLowerCase() === 'x-agency-auth') {\n      const v = String(value ?? '').trim();\n      if (v) return v;\n    }\n  }\n  return '';\n}\n\nconst headers = $input.first().json.headers ?? {};\nconst incoming = readAgencyAuthHeader(headers);\nconst expected = String($env['N8N_AUTH_KEY'] ?? $env['DASHBOARD_AUTH_KEY'] ?? '').trim();\n\nif (!expected) {\n  throw new Error('AUTH_FAIL: N8N_AUTH_KEY is not configured');\n}\n\nif (!incoming || !timingSafeEqualStrings(incoming, expected)) {\n  throw new Error('AUTH_FAIL: Invalid or missing x-agency-auth header');\n}\n\nreturn $input.all();"
      },
      "id": "auth-gate-roster-v2-zero-trust",
      "name": "Auth + Rate Limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
