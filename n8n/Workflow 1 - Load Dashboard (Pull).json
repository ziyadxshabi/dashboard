        -160,
        -48
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const errMsg = ($input.first()?.json?.message ?? 'Unauthorized').toString();\nconst isAuth = errMsg.startsWith('AUTH_FAIL');\nreturn [{ json: { httpStatus: isAuth ? 401 : 503, body: { ok: false, error: isAuth ? 'Unauthorized' : 'Service Unavailable' } } }];"
      },
