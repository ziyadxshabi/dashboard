      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst rowIds = Array.isArray(body.rowIds) ? body.rowIds : [];\n\nif (!rowIds.length) {\n  throw new Error('VALIDATION_FAIL: body.rowIds must be a non-empty array of Baserow row IDs');\n}\n\nconst MAX_BATCH = 100;\nif (rowIds.length > MAX_BATCH) {\n  throw new Error(`VALIDATION_FAIL: batch of ${rowIds.length} exceeds max ${MAX_BATCH}`);\n}\n\nreturn rowIds.map(id => ({ json: { rowId: id } }));"
      },
