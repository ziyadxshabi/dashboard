      "parameters": {
        "jsCode": "// Validate payload shape before doing anything destructive.\n// Accepts parallel arrays: rowIds (Baserow) + calBookingIds (Google Sheets key).\nconst body = $input.first().json.body ?? {};\nconst rowIds = Array.isArray(body.rowIds) ? body.rowIds : [];\nconst calBookingIds = Array.isArray(body.calBookingIds) ? body.calBookingIds : [];\n\nif (!rowIds.length) {\n  throw new Error('VALIDATION_FAIL: body.rowIds must be a non-empty array of Baserow row IDs');\n}\n\nconst MAX_BATCH = 100;\nif (rowIds.length > MAX_BATCH) {\n  throw new Error(`VALIDATION_FAIL: batch of ${rowIds.length} exceeds max ${MAX_BATCH}`);\n}\n\nreturn rowIds.map((id, index) => ({\n  json: {\n    rowId: id,\n    calBookingId: String(calBookingIds[index] ?? '').trim(),\n  },\n}));"
      },
