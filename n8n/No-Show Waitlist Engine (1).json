        "jsCode": "function toE164MA(raw) {\n  if (raw == null || raw === '') return '';\n  let phone = String(raw).replace(/[\\s\\-\\(\\)\\.]/g, '');\n  if (!phone) return '';\n  if (phone.startsWith('+')) return phone;\n  if (phone.startsWith('00')) return '+' + phone.slice(2);\n  if (phone.startsWith('212')) return '+' + phone;\n  if (phone.startsWith('0')) return '+212' + phone.slice(1);\n  return '+212' + phone;\n}\n\nconst PHONE_KEY = 'Téléphone (WhatsApp)';\n\nreturn $input.all().map(item => ({\n  json: {\n    ...item.json,\n    Nom: item.json.Nom ?? item.json.nom ?? 'Patient',\n    [PHONE_KEY]: toE164MA(item.json[PHONE_KEY] ?? '')\n  }\n}));"
      },
