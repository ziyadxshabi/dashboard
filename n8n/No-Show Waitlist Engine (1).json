        "jsCode": "// ── Waitlist auth rejection (401) ────────────────────────────────────────────\nconst err = $input.first()?.json ?? {};\nconst errMsg = (err.message ?? err.error ?? 'Unauthorized').toString();\nconst isAuth = errMsg.startsWith('AUTH_FAIL') || errMsg.startsWith('SIG_FAIL');\n\nreturn [{\n  json: {\n    httpStatus: isAuth ? 401 : 503,\n    body: {\n      ok: false,\n      error: isAuth ? 'Unauthorized' : 'Service Unavailable',\n    },\n  },\n}];"
