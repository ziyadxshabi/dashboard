    {
      "parameters": {
        "jsCode": "// Shared Upstash Redis REST helpers for n8n Code nodes.\n// Env: REDIS_CONNECTION_URL, REDIS_REST_TOKEN\n\nconst REDIS_TIMEOUT_MS = 5000;\n\nasync function redisSetNx(key, ttlSec) {\n  const base = String($env['REDIS_CONNECTION_URL'] ?? '').replace(/\\/+$/, '');\n  const token = String($env['REDIS_REST_TOKEN'] ?? '').trim();\n  if (!base) {\n    return { ok: false, redisError: 'REDIS_CONNECTION_URL missing', acquired: false };\n  }\n  const headers = token ? { Authorization: `Bearer ${token}` } : {};\n  const controller = new AbortController();\n  const timer = setTimeout(() => controller.abort(), REDIS_TIMEOUT_MS);\n  try {\n    const res = await fetch(\n      `${base}/set/${encodeURIComponent(key)}/1?NX=true&EX=${ttlSec}`,\n      { method: 'POST', headers, signal: controller.signal },\n    );\n    clearTimeout(timer);\n    if (!res.ok) {\n      return { ok: false, redisError: `REDIS_HTTP_${res.status}`, acquired: false };\n    }\n    const data = await res.json();\n    return { ok: true, redisError: null, acquired: data.result === 'OK' };\n  } catch (e) {\n    clearTimeout(timer);\n    const msg = e?.name === 'AbortError' ? 'REDIS_TIMEOUT' : String(e?.message ?? e);\n    return { ok: false, redisError: msg, acquired: false };\n  }\n}\n\nconst TTL_SEC = 86400;\n\nfunction normPhone(p) {\n  return String(p ?? '').replace(/[\\s\\-\\(\\)\\.]/g, '').trim();\n}\n\nreturn (async () => {\n  const items = $input.all();\n  const root = items[0]?.json ?? {};\n  const phone = root['Téléphone (WhatsApp)'] ?? root.Telephone ?? root.Phone ?? '';\n  const phoneNorm = normPhone(phone);\n  const patientId = String(root.id ?? root.patient_id ?? root.Nom ?? phoneNorm).trim();\n\n  if (!phoneNorm && !patientId) {\n    return [{ json: { ...root, _waitlistSkip: true, _waitlistRedisError: 'MISSING_CONTACT' } }];\n  }\n\n  const dedupKey = phoneNorm\n    ? `waitlist:notified:${phoneNorm}`\n    : `waitlist:notified:patient:${patientId}`;\n  const lock = await redisSetNx(dedupKey, TTL_SEC);\n\n  if (!lock.ok) {\n    return [{\n      json: {\n        ...root,\n        _waitlistSkip: false,\n        _waitlistRedisError: lock.redisError,\n        _waitlistDedupKey: dedupKey,\n      },\n    }];\n  }\n  if (!lock.acquired) {\n    return [{\n      json: {\n        ...root,\n        _waitlistSkip: true,\n        _waitlistRedisError: null,\n        _waitlistDedupKey: dedupKey,\n      },\n    }];\n  }\n\n  return [{\n    json: {\n      ...root,\n      _waitlistSkip: false,\n      _waitlistRedisError: null,\n      _waitlistDedupKey: dedupKey,\n    },\n  }];\n})();\n"
      },
