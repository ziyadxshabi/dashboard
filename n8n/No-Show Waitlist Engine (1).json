    {
      "parameters": {
        "jsCode": "// ── GATE: Cal.com webhook signature (HMAC-SHA256, timing-safe) ───────────────\nconst crypto = require('crypto');\n\nfunction timingSafeEqualHex(a, b) {\n  const sa = String(a ?? '').trim().toLowerCase();\n  const sb = String(b ?? '').trim().toLowerCase();\n  if (!/^[0-9a-f]+$/.test(sa) || !/^[0-9a-f]+$/.test(sb)) return false;\n  const ba = Buffer.from(sa, 'hex');\n  const bb = Buffer.from(sb, 'hex');\n  if (ba.length !== bb.length) return false;\n  return crypto.timingSafeEqual(ba, bb);\n}\n\nfunction readHeader(h, name) {\n  const target = name.toLowerCase();\n  for (const [key, value] of Object.entries(h ?? {})) {\n    if (key && key.toLowerCase() === target) return String(value ?? '').trim();\n  }\n  return '';\n}\n\nfunction resolveRawBody(item) {\n  if (typeof item.rawBody === 'string' && item.rawBody.length) return item.rawBody;\n  if (typeof item.bodyRaw === 'string' && item.bodyRaw.length) return item.bodyRaw;\n  if (item.body !== undefined && item.body !== null) {\n    return typeof item.body === 'string' ? item.body : JSON.stringify(item.body);\n  }\n  return '';\n}\n\nconst item = $input.first().json ?? {};\nconst headers = item.headers ?? {};\nconst CAL_SECRET = String($env['CAL_WEBHOOK_SECRET'] ?? '').trim();\n\nif (!CAL_SECRET) {\n  throw new Error('AUTH_FAIL: CAL_WEBHOOK_SECRET is not configured');\n}\n\nconst signature = readHeader(headers, 'x-cal-signature-256');\nif (!signature) {\n  throw new Error('AUTH_FAIL: Missing x-cal-signature-256 header');\n}\n\nconst rawBody = resolveRawBody(item);\nconst expected = crypto.createHmac('sha256', CAL_SECRET).update(rawBody, 'utf8').digest('hex');\n\nif (!timingSafeEqualHex(signature, expected)) {\n  throw new Error('AUTH_FAIL: Invalid Cal.com webhook signature');\n}\n\nreturn $input.all();"
      },
