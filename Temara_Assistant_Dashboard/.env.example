/**
 * Assistant dashboard env template.
 * Set real values in Vercel Project Settings → Environment Variables.
 * Do NOT commit a .env file with production secrets.
 */

JWT_SECRET=replace-with-long-random-secret-min-32-chars
N8N_AUTH_KEY=your-agency-auth-secret
# Rollback: unused by /api/roster after Baserow cutover
N8N_WEBHOOK_ROSTER=https://your-ngrok-host.ngrok-free.dev/webhook/assistant-data

# Baserow REST (used by /api/roster). Do not commit the real token.
BASEROW_API_TOKEN=your_baserow_database_token

# Optional Upstash Redis (roster GET cache). If unset, APIs work uncached.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
